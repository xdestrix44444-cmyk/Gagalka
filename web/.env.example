# Скопируйте в .env и вставьте ключ. Файл .env не попадает в git.
# Gemini (бесплатный лимит): ключ из https://aistudio.google.com/apikey. Если задан — толкует Gemini.
GEMINI_API_KEY=
# Модель Gemini, по умолчанию gemini-3.6-flash (запасные: 3.7-flash, 3.5-flash-lite)
# GEMINI_MODEL=gemini-3.6-flash
# Claude — если ключа Gemini нет
ANTHROPIC_API_KEY=
# Сколько толкований в час можно запросить с одного адреса
READINGS_PER_HOUR=30
# На хостинге за прокси: брать адрес клиента из X-Forwarded-For
# TRUST_PROXY=1
# Откуда приложению можно обращаться к серверу (по умолчанию отовсюду)
# ALLOW_ORIGIN=https://xdestrix44444-cmyk.github.io
